# Copiar a .env.local solo en desarrollo. Nunca pongas secretos aquí:
# todo lo que empieza por NEXT_PUBLIC_ se incrusta en el JavaScript que recibe el navegador.

# Base de la API v1 que llama el navegador. Por defecto /api/v1 (mismo origen: en local el
# gateway de docker compose pone la web y la API en http://127.0.0.1:8088).
# Para desarrollar sin gateway puede ser un origen completo, por ejemplo
# http://127.0.0.1:8000/api/v1 (la API debe permitir ese origen en ORIGENES_WEB y la cookie
# de sesión debe poder viajar entre ambos puertos).
# Se fija al compilar (next build): cambiarla exige volver a compilar la imagen.
NEXT_PUBLIC_API_BASE=/api/v1

# Fuente de datos (solo servidor, se lee en cada petición):
#   http  -> la API real (valor por defecto)
#   demo  -> datos ficticios en memoria; toda pantalla muestra «Datos de demostración»
# Cualquier otro valor hace fallar cada página (error 500 con el motivo en el registro)
# en vez de mostrar datos equivocados.
FUENTE_DATOS=http

# Origen de las pantallas actuales de la plataforma (Jinja), para lo que esta web aún enlaza: Proyectos,
# Usuarios y la revisión completa de un gasto. En local con docker compose, http://127.0.0.1:8000.
# Vacío: esos enlaces no se muestran. Se fija al compilar, como NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_PLATAFORMA_URL=
