    {
      "id": "ac66a1a5-dd52-5dd2-bd93-4ae2088b5251",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Verifica el aviso de la plataforma antes de hacer nada con él: firma, hora, destino del enlace y repetidos.\n// El secreto sale de la variable de n8n INFLIGHT_WEBHOOK_SECRETO si existe; si no, del nodo «Configuración».\n// Nada de lo que sale de aquí lleva el secreto.\nconst crypto = require('crypto');\nconst entrada = $input.first();\nconst conf = entrada.json;\nconst salida = (estado, motivo, extra = {}) => [{ json: { estado, motivo, ...extra } }];\n\nlet secreto = '';\ntry { secreto = ($vars && $vars.INFLIGHT_WEBHOOK_SECRETO) || ''; } catch (e) { secreto = ''; }\nif (!secreto) secreto = String(conf.secreto_webhook || '');\nif (!secreto || secreto.startsWith('PEGAR_AQUI')) return salida('invalida', 'Falta configurar el secreto del aviso');\n\nconst cabeceras = conf.headers || {};\nconst partes = {};\nfor (const p of String(cabeceras['x-inflight-firma'] || '').split(',')) {\n  const i = p.indexOf('=');\n  if (i > 0) partes[p.slice(0, i).trim()] = p.slice(i + 1).trim();\n}\nconst t = Number(partes.t);\nif (!Number.isFinite(t) || !/^[0-9a-f]{64}$/.test(partes.v1 || '')) return salida('invalida', 'Falta la firma o no tiene el formato esperado');\nif (Math.abs(Date.now() / 1000 - t) > 300) return salida('invalida', 'La firma tiene más de 5 minutos');\n\n// El cuerpo tal cual llegó (opción «Raw Body» del Webhook). Si no estuviera, el JSON leído sirve: la plataforma\n// lo envía compacto, igual a JSON.stringify.\nlet crudo;\ntry { crudo = await this.helpers.getBinaryDataBuffer(0, 'data'); } catch (e) { crudo = null; }\nif (!crudo || !crudo.length) crudo = Buffer.from(JSON.stringify(conf.body), 'utf8');\n\nconst esperado = crypto.createHmac('sha256', secreto).update(Buffer.concat([Buffer.from(`${partes.t}.`, 'utf8'), crudo])).digest();\nconst recibido = Buffer.from(partes.v1, 'hex');\nif (recibido.length !== esperado.length || !crypto.timingSafeEqual(recibido, esperado)) return salida('invalida', 'La firma no coincide');\n\nlet datos;\ntry { datos = JSON.parse(crudo.toString('utf8')); } catch (e) { return salida('invalida', 'El cuerpo no es JSON'); }\nif (datos.evento !== 'gasto.registrado' || !datos.entrega || !datos.gasto_id) return salida('invalida', 'No es un aviso gasto.registrado');\n\n// La clave de servicio solo viaja a la plataforma: un enlace que apunte a otro sitio se rechaza\nconst base = String(conf.url_plataforma || '').replace(/\\/+$/, '');\nif (!base || !String(datos.enlace_soporte || '').startsWith(`${base}/api/v1/servicio/gastos/${datos.gasto_id}/soporte?`)) {\n  return salida('invalida', 'El enlace al soporte no apunta a la plataforma configurada');\n}\n\n// Una misma entrega no se procesa dos veces (la plataforma repite el id en sus reintentos)\nconst memoria = $getWorkflowStaticData('global');\nmemoria.entregas = Array.isArray(memoria.entregas) ? memoria.entregas : [];\nif (memoria.entregas.includes(datos.entrega)) return salida('repetida', 'Esta entrega ya se procesó', { entrega: datos.entrega });\nmemoria.entregas = [...memoria.entregas, datos.entrega].slice(-500);\n\nconst limpiar = (texto, defecto) => String(texto ?? '').replace(/[\\\\/:*?\"<>|\\u0000-\\u001f]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 80) || defecto;\nconst paraConsulta = (texto) => texto.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\nconst mes = /^\\d{4}-\\d{2}/.test(datos.fecha || '') ? datos.fecha.slice(0, 7) : new Date().toISOString().slice(0, 7);\nconst carpetas = {\n  raiz: limpiar(conf.carpeta_raiz, 'Inflight · Soportes'),\n  proyecto: limpiar(datos.proyecto, 'Sin proyecto'),\n  viaje: limpiar(datos.viaje, 'Sin viaje'),\n  mes,\n};\nconst total = datos.total ? `${datos.total} ${datos.moneda || ''}`.trim() : 'sin total';\nconst nombre_base = [limpiar(datos.fecha, 'sin fecha'), limpiar(datos.comercio, 'sin comercio'), total,\n  limpiar(datos.viaje, `gasto ${datos.gasto_id}`)].join(' · ');\n\nreturn [{ json: {\n  estado: 'valida', motivo: '', entrega: datos.entrega, gasto_id: datos.gasto_id, enlace_soporte: datos.enlace_soporte,\n  carpetas, consulta: Object.fromEntries(Object.entries(carpetas).map(([k, v]) => [k, paraConsulta(v)])), nombre_base,\n} }];\n"
      }
    },
