    {
      "id": "0fda60f6-e661-5456-8f0b-ad702ff40337",
      "name": "Preparar lectura",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5280,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Deja la lectura de la factura como archivo JSON, en la misma carpeta del soporte y con el mismo nombre base.\nconst verificado = $('Verificar firma').first().json;\nconst aviso = verificado.aviso || {};\nconst carpeta = $('Preparar archivo').first().json.carpeta;\nconst soporte = $input.first().json;   // lo que devolvió «Subir a Drive»\nconst contenido = {\n  gasto: {\n    id: aviso.gasto_id, estado: aviso.estado, proyecto: aviso.proyecto, viaje: aviso.viaje, persona: aviso.persona,\n    fecha: aviso.fecha, comercio: aviso.comercio, categoria: aviso.categoria, total: aviso.total, moneda: aviso.moneda,\n    total_usd: aviso.total_usd, alertas: aviso.alertas || [], enlace: aviso.enlace_gasto || null,\n  },\n  lectura: aviso.lectura ?? null,\n  soporte_en_drive: soporte.id ? `https://drive.google.com/file/d/${soporte.id}/view` : null,\n  entrega: aviso.entrega,\n};\nconst nombre = `${verificado.nombre_base} · lectura.json`;\nconst bytes = Buffer.from(JSON.stringify(contenido, null, 2), 'utf8');\nlet binario;\ntry {\n  binario = await this.helpers.prepareBinaryData(bytes, nombre, 'application/json');\n} catch (e) {   // si el plan de n8n no ofrece el ayudante, el archivo va en base64, que n8n también acepta\n  binario = { data: bytes.toString('base64'), mimeType: 'application/json', fileName: nombre, fileExtension: 'json' };\n}\nreturn [{ json: { carpeta, nombre, soporte_id: soporte.id || null }, binary: { data: binario } }];\n"
      }
    },
