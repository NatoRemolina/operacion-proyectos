    {
      "id": "08165146-a362-5342-9f90-4103ef59a6d5",
      "name": "Preparar archivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4840,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Junta el archivo descargado con la carpeta del mes y le pone el nombre legible.\nconst descarga = $('Descargar soporte').first();\nconst aviso = $('Verificar firma').first().json;\nconst archivo = descarga.binary && descarga.binary.data;\nif (!archivo) throw new Error('La descarga del soporte no trajo el archivo');\nconst extension = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'application/pdf': 'pdf', 'message/rfc822': 'eml' }[archivo.mimeType]\n  || archivo.fileExtension || 'bin';\nconst nombre = `${aviso.nombre_base}.${extension}`;\nreturn [{\n  json: { carpeta: $input.first().json.id, nombre, gasto_id: aviso.gasto_id, entrega: aviso.entrega },\n  binary: { data: { ...archivo, fileName: nombre } },\n}];\n"
      }
