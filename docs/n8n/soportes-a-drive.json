    {
      "id": "21fb4c6f-401f-567c-b56b-f81f759383d8",
      "name": "Fila de la hoja",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5720,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Una fila por gasto para la hoja «Lecturas»: lo leído de la factura, el estado y los enlaces.\n// La hoja guarda los valores tal cual («Agregar a la hoja» escribe en modo RAW): un texto que empieza con = no se vuelve\n// fórmula, «000123» conserva sus ceros y «12-10» no se convierte en fecha.\nconst aviso = $('Verificar firma').first().json.aviso || {};\nconst lectura = aviso.lectura || {};\nconst soporteId = $('Preparar lectura').first().json.soporte_id;\nconst lecturaId = $input.first().json.id;\nconst enlace = (id) => (id ? `https://drive.google.com/file/d/${id}/view` : '');\nconst texto = (v) => String(v ?? '').replace(/\\s+/g, ' ').trim();\n// Los importes llegan de la plataforma ya validados, como texto con dos decimales: en la hoja van como número\nconst numero = (v) => { const n = Number(v); return v === null || v === undefined || v === '' || !Number.isFinite(n) ? '' : n; };\nconst lista = (v) => (Array.isArray(v) ? v : []);\nreturn [{ json: {\n  'Gasto': aviso.gasto_id,\n  'Fecha de carga (UTC)': new Date().toISOString().slice(0, 16).replace('T', ' '),\n  'Estado': texto(aviso.estado),\n  'Proyecto': texto(aviso.proyecto),\n  'Viaje': texto(aviso.viaje),\n  'Persona': texto(aviso.persona),\n  'Comercio': texto(aviso.comercio),\n  'NIT o ID fiscal': texto(lectura.id_fiscal),\n  'N.º factura': texto(lectura.numero_factura),\n  'Fecha': texto(aviso.fecha),\n  'Categoría': texto(aviso.categoria),\n  'Base': numero(lectura.subtotal),\n  'Impuesto': numero(lectura.impuesto),\n  'Propina': numero(lectura.propina),\n  'Total': numero(aviso.total),\n  'Moneda': texto(aviso.moneda),\n  'Total USD': numero(aviso.total_usd),\n  'Confianza': numero(lectura.confianza),\n  'Dudas': texto(lista(lectura.dudas).join(', ')),\n  'Alertas': texto(lista(aviso.alertas).join(' ')),\n  'Líneas': texto(lista(lectura.lineas).map((l) => [l.descripcion, l.cantidad ? `× ${l.cantidad}` : '', l.total].filter(Boolean).join(' ')).join(' | ')),\n  'Soporte en Drive': enlace(soporteId),\n  'Lectura en Drive': enlace(lecturaId),\n  'Gasto en la plataforma': texto(aviso.enlace_gasto),\n} }];\n"
      }
    },
