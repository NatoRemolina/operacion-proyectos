          "401": {
            "description": "Sin sesión, sesión vencida o credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "403": {
            "description": "Token CSRF ausente o inválido, u origen no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "409": {
            "description": "Misma Idempotency-Key con un archivo distinto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "413": {
            "description": "Archivo de más de 4,5 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "415": {
            "description": "El contenido no es JPG, PNG, WebP, PDF ni correo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
