  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Pública: no lleva token CSRF. El rol y la persona salen de la cuenta, nunca del cuerpo.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ingreso"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sesion"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión, sesión vencida o credenciales incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "403": {
            "description": "Token CSRF ausente o inválido, u origen no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos; detalle por campo en `fields`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos de ingreso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaError"
                }
              }
            }
          }
        }
      }
    },
