      "post": {
        "tags": [
          "gastos"
        ],
        "summary": "Enviar",
        "description": "Lee y valida el recibo. Responde con su estado real: `aprobado_auto` o `revision` (que no es un error).\n\nFunción normal (no asíncrona): la lectura con el modelo corre en un hilo y no detiene al resto del servidor.",
        "operationId": "enviar_api_v1_gastos_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Un valor único por archivo, que se repite si se reintenta el mismo envío.",
              "title": "Idempotency-Key"
            },
            "description": "Un valor único por archivo, que se repite si se reintenta el mismo envío."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_enviar_api_v1_gastos_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GastoDetalle"
                }
              }
            }
