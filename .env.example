# Copiar a .env y completar. Sin ninguna clave la aplicación funciona con datos guardados.

# Precios de vuelos y hoteles
SERPAPI_KEY=

# Modelo multimodal para leer recibos (API de mensajes con imágenes y PDF)
MODELO_API_URL=
MODELO_API_KEY=
MODELO_NOMBRE=
# Cabeceras adicionales en JSON, si el proveedor las exige
MODELO_CABECERAS={}

# Base de datos. Vacío = SQLite local. Con Supabase: cadena de conexión de Postgres
DATABASE_URL=
# Opcional: si DATABASE_URL conserva el marcador [YOUR-PASSWORD], la contraseña va aquí tal cual
DATABASE_PASSWORD=
# Archivos. Vacío = carpeta local. Con Supabase: URL del proyecto, clave de servicio y bucket
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=soportes

# Contraseña de acceso a la página (obligatoria si se publica en internet)
APP_CLAVE=
