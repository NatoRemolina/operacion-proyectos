# Copiar a .env y completar. Sin ninguna clave la plataforma funciona en local con datos guardados
# y tres cuentas de demostración (ver README).

# Precios de vuelos y hoteles
SERPAPI_KEY=

# Modelo de lenguaje multimodal para leer recibos y para el agente
MODELO_API_URL=
MODELO_API_KEY=
MODELO_NOMBRE=
# Formato de la API: "gemini" o "mensajes". Vacío = se deduce de la dirección
MODELO_FORMATO=
# Cabeceras adicionales en JSON, si el proveedor las exige
MODELO_CABECERAS={}

# Asesor del asistente (opcional). Vacío = apagado: el asistente usa el modelo de lenguaje o el modo determinista.
# Dirección base del servicio de agentes (sin /v1), su clave y los identificadores del agente y del entorno
ASESOR_API_URL=
ASESOR_API_KEY=
ASESOR_AGENTE_ID=
ASESOR_ENTORNO_ID=
# Cabeceras que exige el servicio (versión de la API y función en prueba), en JSON
ASESOR_CABECERAS={}

# Base de datos. Vacío = SQLite local. Con Postgres: cadena de conexión
DATABASE_URL=
# Opcional: si DATABASE_URL conserva el marcador [YOUR-PASSWORD], la contraseña va aquí tal cual
DATABASE_PASSWORD=
# Archivos. Vacío = carpeta local. Con almacenamiento remoto: dirección del proyecto, clave de servicio y bucket
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=soportes

# Primera cuenta de administrador en una base compartida (solo se usa cuando aún no hay cuentas)
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CLAVE=

# Canal de Telegram (opcional). Vacío = apagado. Ver docs/datos.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOMBRE=
TELEGRAM_WEBHOOK_SECRETO=

# Índice del asistente (opcional). Vacío = índice local por palabras. Ver docs/asistente.md
PINECONE_API_KEY=
# Nombre del índice (para crearlo con `python -m datos.indexar --crear-indice`) y su dirección (host) una vez creado
PINECONE_INDICE=asistente-fichas
PINECONE_HOST=
